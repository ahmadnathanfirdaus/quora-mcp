# Kosongkan untuk pemakaian lokal (endpoint: http://127.0.0.1:8787/mcp, HOST wajib 127.0.0.1).
# Wajib diisi kalau di-deploy ke VPS. Bikin pakai: openssl rand -hex 24
MCP_SECRET=
HOST=127.0.0.1

# Docker di laptop sendiri tanpa secret: set 1. Port container cuma dibuka ke 127.0.0.1 (docker-compose.yml).
# JANGAN set di VPS.
LOCAL_ONLY=

# Opsional: cookie sesi Quora (read-only). Kalau diisi, tool quora_search muncul dan pakai pencarian Quora asli.
# Ambil dari DevTools > Application > Cookies > quora.com. Minimal m-b dan m-lat.
# Saran: pakai akun Quora cadangan, bukan akun utama.
QUORA_COOKIE=

# Tuning (opsional)
MAX_CONCURRENCY=2
MIN_DELAY_MS=1500
CACHE_TTL_MIN=30
NAV_TIMEOUT_MS=30000
